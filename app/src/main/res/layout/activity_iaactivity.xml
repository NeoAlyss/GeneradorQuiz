<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".IAActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtPreguntasIA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/txtTituloIA"
            style="@style/TituloPantalla"/>

        <ImageButton
            android:id="@+id/btnVolverIA"
            style="@style/BotonIcono"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/btnVolverMenu"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/txtTemaIA"
            style="@style/TextoFilaTitulo" />

        <EditText
            android:id="@+id/edtAnimo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="@string/edtTemaIAHint"
            android:textSize="16sp"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/txtNumeroPreguntas"
                style="@style/TextoFilaTitulo" />

            <EditText
                android:id="@+id/edtCantPreguntasIA"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:text="@string/edtCantPreguntasIADefecto"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnRestarPreguntasIA"
                style="@style/BotonContador"
                android:layout_marginStart="8dp"
                android:text="@string/btnRestarPreguntas" />

            <Button
                android:id="@+id/btnSumarPreguntasIA"
                style="@style/BotonContador"
                android:layout_marginStart="4dp"
                android:text="@string/btnSumarPreguntas" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGenerarIA"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/btnGenerarIA"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/txtQuizSugeridoIA"
            style="@style/TextoFilaTitulo"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:background="@color/fondoTarjeta">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="10dp">

                <TextView
                    android:id="@+id/txtPreguntaGenerada1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/txtPreguntaGenerada1"
                    style="@style/TextoPregunta" />

                <RadioGroup
                    android:id="@+id/rgUsoRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbEstudiar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:checked="true"
                        android:text="@string/rbP1Op1IA" />

                    <RadioButton
                        android:id="@+id/rbEnsenar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/rbP1Op2IA" />

                    <RadioButton
                        android:id="@+id/rbJugar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/rbP1Op3IA" />
                </RadioGroup>

                <TextView
                    android:id="@+id/txtPreguntaGenerada2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/txtPreguntaGenerada2"
                    style="@style/TextoPregunta" />

                <RadioGroup
                    android:id="@+id/rgPreguntaGenerada2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbP2Op1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:checked="true"
                        android:text="@string/rbP2Op1IA" />

                    <RadioButton
                        android:id="@+id/rbP2Op2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/rbP2Op2IA" />

                    <RadioButton
                        android:id="@+id/rbP2Op3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/rbP2Op3IA" />
                </RadioGroup>

                <TextView
                    android:id="@+id/txtPreguntaGenerada3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/txtPreguntaGenerada3"
                    style="@style/TextoPregunta" />

                <RadioGroup
                    android:id="@+id/rgPreguntaGenerada3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbP3Op1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:checked="true"
                        android:text="@string/rbP3Op1IA" />

                    <RadioButton
                        android:id="@+id/rbP3Op2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/rbP3Op2IA" />

                    <RadioButton
                        android:id="@+id/rbP3Op3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/rbP3Op3IA" />
                </RadioGroup>

                <TextView
                    android:id="@+id/txtPreguntaGenerada4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/txtPreguntaGenerada4"
                    style="@style/TextoPregunta" />

                <RadioGroup
                    android:id="@+id/rgPreguntaGenerada4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbP4Op1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:checked="true"
                        android:text="@string/rbP4Op1IA" />

                    <RadioButton
                        android:id="@+id/rbP4Op2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/rbP4Op2IA" />

                    <RadioButton
                        android:id="@+id/rbP4Op3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/rbP4Op3IA" />
                </RadioGroup>
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnGuardarIA"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/btnGuardarQuiz"/>
    </LinearLayout>

</LinearLayout>