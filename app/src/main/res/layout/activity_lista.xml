<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ListaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtTituloLista"
            style="@style/TituloPantalla"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name" />

        <ImageButton
            android:id="@+id/btnSalirLista"
            style="@style/BotonIcono"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/btnSalirLista" />

    </LinearLayout>

    <Button
        android:id="@+id/btnJugarLista"
        style="@style/BotonMenu"
        android:text="@string/btnJugarLista" />

    <Button
        android:id="@+id/btnNuevoQuizLista"
        style="@style/BotonMenu"
        android:text="@string/btnNuevoQuizLista" />

    <Button
        android:id="@+id/btnIALista"
        style="@style/BotonMenu"
        android:text="@string/btnIALista" />

</LinearLayout>