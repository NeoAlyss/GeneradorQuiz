<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".RegistroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/txtTituloRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/txtTituloRegistro"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="@string/txtSubRegistro"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtNombreRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/edtNombreRegistro"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/edtCorreoRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/edtCorreoRegistro"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/edtContrasenaRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/edtContrasenaRegistro"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/edtRepetirContrasenaRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/edtRepetirContrasenaRegistro"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/txtPreguntaRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/txtPreguntaRegistro"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgUsoRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbEstudiar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/rbEstudiar" />

            <RadioButton
                android:id="@+id/rbEnsenar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rbEnsenar" />

            <RadioButton
                android:id="@+id/rbJugar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rbJugar" />

        </RadioGroup>

        <CheckBox
            android:id="@+id/chkTerminosRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/chkTerminosRegistro" />

        <Button
            android:id="@+id/btnCrearCuentaRegistro"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btnCrearCuentaRegistro" />

        <TextView
            android:id="@+id/txtVolverLoginRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/txtVolverLoginRegistro"
            android:textColor="@color/primario" />

    </LinearLayout>

</ScrollView>