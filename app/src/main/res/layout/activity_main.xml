<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="54dp"
        android:layout_marginStart="62dp"
        android:layout_marginEnd="62dp"
        android:adjustViewBounds="true"
        android:src="@drawable/logo_quizmaker"
        android:contentDescription="@string/imgLogo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/edtCorreoLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:hint="@string/edtCorreoLogin"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/edtClaveLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:hint="@string/edtClaveLogin"
        android:inputType="textPassword"
        app:layout_constraintTop_toBottomOf="@id/edtCorreoLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <CheckBox
        android:id="@+id/chkRecordarLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/chkRecordarLogin"
        app:layout_constraintTop_toBottomOf="@id/edtClaveLogin"
        app:layout_constraintStart_toStartOf="@id/edtClaveLogin" />

    <Button
        android:id="@+id/btnIngresarLogin"
        style="@style/BotonPrincipal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btnIngresarLogin"
        app:layout_constraintTop_toBottomOf="@id/chkRecordarLogin"
        app:layout_constraintStart_toStartOf="@id/edtClaveLogin"
        app:layout_constraintEnd_toEndOf="@id/edtClaveLogin" />

    <TextView
        android:id="@+id/txtIrARegistro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="@string/txtIrARegistro"
        android:textColor="@color/primario"
        app:layout_constraintTop_toBottomOf="@id/btnIngresarLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>